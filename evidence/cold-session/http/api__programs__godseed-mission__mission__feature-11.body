{"program_id":"godseed-mission","node":{"id":"feature-11","type":"requirement","title":"Feature 11: Cross-session protocol: fresh AI given one PURL discovers allowed operations, reads state, proposes or executes according to actual access, and another session reconstructs","text":"Cross-session protocol: fresh AI given one PURL discovers allowed operations, reads state, proposes or executes according to actual access, and another session reconstructs. Browser-read-only clients get prepare links rather than pretend mutations. No unauthorized third-party automation.","dependencies":["feature-2","feature-8"],"status":"NOT_RUN","effects":["local-state"],"operations":["inspect","propose","checkpoint"],"tests":[{"id":"feature-11:evidence","assertion":"Evidence is addressable, verified and meets the stated requirement"}],"completion_predicate":{"operator":"all","clauses":[{"operator":"dependencies_pass"},{"operator":"evidence_verified"},{"operator":"tests_pass"}]},"evidence":[],"href":"http://127.0.0.1:8080/api/programs/godseed-mission/mission/feature-11"},"dependencies":[{"id":"feature-2","type":"requirement","title":"Feature 2: Human accounts, optional guests, principals, claimed AI identities, capabilities, grants, public/private/unlisted resources, session continuation, proposals, checkpoint/replay and scoped authority","text":"Human accounts, optional guests, principals, claimed AI identities, capabilities, grants, public/private/unlisted resources, session continuation, proposals, checkpoint/replay and scoped authority.","dependencies":["formal-contract"],"status":"NOT_RUN","effects":["local-state"],"operations":["inspect","propose","checkpoint"],"tests":[{"id":"feature-2:evidence","assertion":"Evidence is addressable, verified and meets the stated requirement"}],"completion_predicate":{"operator":"all","clauses":[{"operator":"dependencies_pass"},{"operator":"evidence_verified"},{"operator":"tests_pass"}]},"evidence":[],"href":"http://127.0.0.1:8080/api/programs/godseed-mission/mission/feature-2"},{"id":"feature-8","type":"requirement","title":"Feature 8: Persistent Supabase/Postgres schema: users, workspaces, principals, grants, programs, versions, transitions, proposals, executions, checkpoints, blobs, research artifacts, provenance, logs","text":"Persistent Supabase/Postgres schema: users, workspaces, principals, grants, programs, versions, transitions, proposals, executions, checkpoints, blobs, research artifacts, provenance, logs. Migrations, RLS, indices, backups and rollback. Immutable objects in Storage.","dependencies":["feature-2"],"status":"NOT_RUN","effects":["local-state"],"operations":["inspect","propose","checkpoint"],"tests":[{"id":"feature-8:evidence","assertion":"Evidence is addressable, verified and meets the stated requirement"}],"completion_predicate":{"operator":"all","clauses":[{"operator":"dependencies_pass"},{"operator":"evidence_verified"},{"operator":"tests_pass"}]},"evidence":[],"href":"http://127.0.0.1:8080/api/programs/godseed-mission/mission/feature-8"}],"operations":[{"name":"fork","method":"POST","href":"http://127.0.0.1:8080/api/programs/godseed-mission/fork","available":false,"requires":["authenticated","read"],"effects":["local-state"],"input_schema":{"type":"object","properties":{"expected_version":{"type":"integer","const":1}},"required":["expected_version"]},"prepare":{"href":"http://127.0.0.1:8080/p/godseed-mission?prepare=fork","mode":"human-mediated","description":"Read-only clients can prepare this operation in the browser; mutations require a bearer session."}},{"name":"checkpoint","method":"POST","href":"http://127.0.0.1:8080/api/programs/godseed-mission/checkpoint","available":false,"requires":["authenticated","checkpoint"],"effects":["local-state"],"input_schema":{"type":"object","properties":{"expected_version":{"type":"integer","const":1},"summary":{"type":"string"},"next":{},"evidence":{}},"required":["expected_version"]},"prepare":{"href":"http://127.0.0.1:8080/p/godseed-missio