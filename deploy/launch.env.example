# LOCAL DEVELOPMENT: copy to .env.launch (gitignored). Never commit real secrets.
# Required: generate 32 cryptographic random bytes and encode as canonical base64.
# Keep this key with the local data volume: changing it invalidates encrypted data.
PURL_IDENTITY_ENCRYPTION_KEY=

# OIDC is intentionally unconfigured. Guests are explicitly unverified.
# To enable a real provider, register exact separate product callbacks first.
# PURL_OIDC_ISSUER=https://<project-ref>.supabase.co/auth/v1
# PURLS_OIDC_CLIENT_ID=<purls-client-id>
# PURLS_OIDC_CLIENT_SECRET=<purls-client-secret>
# CGIT_OIDC_CLIENT_ID=<cgit-client-id>
# CGIT_OIDC_CLIENT_SECRET=<cgit-client-secret>
# Compose maps each product pair to that API's PURL_OIDC_CLIENT_ID/SECRET.
# Production must configure those primary names separately per Railway service.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<provider-publishable-key>
# SUPABASE_AUTH_REDIRECT_ALLOWLIST=https://<existing-consent-origin>/oauth/consent
# PURL_OIDC_RECOVERY_URL=https://<configured-provider-owned-recovery-url>

# Optional encrypted BYOK storage: separate 32-byte base64 key, kept with backups.
# MODEL_ENCRYPTION_KEY=<generated-model-encryption-key>
# OPENROUTER_MODEL_CATALOG_JSON=<JSON array with verified model ids and numeric microUSD/token prices>
# MODEL_DAILY_BUDGET_MICROUSD=<approved-positive-integer-budget>
# MODEL_CALL_BUDGET_MICROUSD=<approved-positive-integer-budget>
# MODEL_DAILY_CALL_LIMIT=<approved-positive-integer-limit>
# MODEL_TIMEOUT_MS=<timeout-in-milliseconds-at-most-120000>
# Compose deliberately keeps MODEL_HOSTED_ENABLED=false; no hosted key is supplied.
# PURL_GITHUB_READ_TOKEN=<optional-server-only-read-token>

# PRODUCTION: configure Railway shared/service secrets, not this local env file.
# Required backend authority: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Set NODE_ENV=production and PURL_LAUNCH_PERSISTENCE=supabase per runbook.
# Do not use PURL_PERSISTENCE/PURL_DATA_FILE: those belong to the legacy runtime.
