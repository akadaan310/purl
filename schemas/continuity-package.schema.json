{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:purl:schema:continuity-package",
  "title": "Continuity package",
  "description": "Selected state carried from one session to another through a checkpoint. Everything in the package is a CLAIM by its preparer; the server separately records the verified checkpoint (resource, version, state hash) next to it.",
  "type": "object",
  "required": ["task", "objective"],
  "additionalProperties": false,
  "properties": {
    "task": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "findings": {
      "type": "array", "maxItems": 100,
      "items": {
        "anyOf": [
          { "type": "string", "maxLength": 2000 },
          { "type": "object", "required": ["entry"], "additionalProperties": false, "properties": { "entry": { "type": "string" }, "summary": { "type": "string", "maxLength": 2000 } } }
        ]
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
    "open_questions": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
    "constraints": { "type": "array", "items": { "type": "string", "maxLength": 2000 }, "maxItems": 100 },
    "requested_operation": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "required": ["operation"], "additionalProperties": false,
          "properties": {
            "operation": { "type": "string", "maxLength": 64 },
            "input": { "type": "object" },
            "note": { "type": "string", "maxLength": 2000 }
          }
        }
      ]
    },
    "profile": { "anyOf": [{ "type": "null" }, { "$ref": "urn:purl:schema:communication-profile" }] }
  }
}
