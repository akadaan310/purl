{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:purl:schema:compute-node",
  "title": "Computation node (purl.compute/0.1)",
  "description": "The state of a PURL resource that participates in a computation graph. A literal holds a value. An application holds the operation, a pin for each operand, and the value its creator computed. The value of an application is a CLAIM by the principal that created the resource: the PURL server stores it but never evaluates it. Anyone can check it by reading each operand at its pinned version, comparing state hashes and re-evaluating the operation.",
  "type": "object",
  "required": ["compute", "node", "value"],
  "properties": {
    "compute": { "const": "purl.compute/0.1" },
    "node": { "enum": ["literal", "application"] },
    "value": { "type": "string", "pattern": "^[01]{1,4096}$" },
    "operation": { "enum": ["NOT", "AND", "OR", "XOR", "CONCAT", "HASH"] },
    "operands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["resource", "version", "state_hash"],
        "additionalProperties": false,
        "properties": {
          "resource": { "type": "string", "pattern": "^r_[0-9A-Z]{4,16}$" },
          "version": { "type": "integer", "minimum": 1 },
          "state_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "evaluator": { "type": "string", "maxLength": 200 }
  },
  "oneOf": [
    { "properties": { "node": { "const": "literal" } } },
    { "properties": { "node": { "const": "application" } }, "required": ["operation", "operands", "evaluator"] }
  ]
}
