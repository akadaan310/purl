# DEVELOPMENT only. Production must use Supabase, never a local file.
NODE_ENV=development
PORT=3000
PURL_BASE_URL=http://localhost:3000
PURL_PERSISTENCE=file
PURL_DATA_FILE=./.purl/state.json
PURL_ROLE=api

# Set only in server/worker secret settings; never in browser code or Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ARTIFACT_BUCKET=purl-artifacts
PURL_DOCUMENT_ID=main
PURL_CURATOR_IDS=

# Separate worker process, with durable claim/recovery in the shared repository.
PURL_WORKER_ID=
PURL_WORKER_POLL_MS=500
PURL_JOB_LEASE_MS=30000
PURL_WORKER_HEARTBEAT_FILE=/tmp/purl-worker-heartbeat.json
PURL_WORKER_HEALTH_MAX_AGE_MS=120000

# Authored JavaScript/TypeScript/Python remain denied until an isolated adapter is configured.
PURL_SANDBOX_ENABLED=0
PURL_SANDBOX_VERIFIED=0
